  "faq": [
    {
      "domanda": "Che differenza c'è tra CSO01 e CSO02?",
      "risposta": "La CSO01 è una colonna ad altezza fissa, la CSO02 ha regolazione in altezza di ±150mm. Entrambe sono un'alternativa compatta ai banchi STR per il supporto delle basi circolari, disponibili in acciaio (Fe) e inox (AISI)."
    },
    {
      "domanda": "Quando usare una colonna CSO invece di un banco STR?",
      "risposta": "Le colonne CSO sono ideali quando serve maggiore compattezza e si monta solo una base vibrante circolare. I banchi STR sono preferibili per isole di asservimento complete con più componenti."
    },
    {
      "domanda": "Quanti tipi di rivestimento avete?",
      "risposta": "Deca offre 15 rivestimenti: Vulkollan 2-3mm (liscio/ruvido), Chiorino NA1120 e contrario, Panno novu 12HC, Shram a spruzzo 1mm, Remathan 6-10mm (liscio/ruvido), Brushlon verde 6mm, Teflon e Antirombo esterno."
    },
    {
      "domanda": "Quale rivestimento per particolari delicati?",
      "risposta": "Per particolari delicati consigliamo Vulkollan liscio (RIV01 da 2mm o RIV03 da 3mm) che offre protezione senza graffiare, oppure il Panno novu 12HC (RIV10) per superfici molto sensibili."
    },
    {
      "domanda": "Come ridurre il rumore del vibratore?",
      "risposta": "Il RIV18 (Antirombo esterno) è specificamente progettato per lo smorzamento del rumore, applicato all'esterno del contenitore. Per ridurre ulteriormente il rumore interno, un rivestimento in Remathan spesso (RIV14, 10mm) assorbe bene le vibrazioni."
    }
  ]
}