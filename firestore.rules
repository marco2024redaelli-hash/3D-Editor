rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /chat_sessions/{sessionId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if false;
    }
    match /analytics_sessions/{docId} {
      allow read: if true;
      allow write: if true;
    }
    match /model_feedback/{docId} {
      allow read: if true;
      allow write: if true;
    }
    match /annotations/{docId} {
      allow read: if true;
      allow write: if true;
    }
    match /feature_requests/{docId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
