rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'marco2024redaelli@gmail.com';
    }

    match /chat_sessions/{sessionId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin();
    }
    match /analytics_sessions/{docId} {
      allow read: if isAdmin();
      allow write: if true;
    }
    match /model_feedback/{docId} {
      allow read: if isAdmin();
      allow write: if true;
    }
    match /annotations/{docId} {
      allow read: if true;
      allow write: if true;
    }
    match /feature_requests/{docId} {
      allow read: if true;
      allow write: if true;
    }
    match /preventivi/{docId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if false;
    }
    match /site_visits/{docId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if false;
    }
  }
}
