          <div style={
    { display: "flex", height: 14, borderRadius: 4, overflow: "hidden", gap: 1
    }
  }>
            {
    [
      { label: "Base 4-bit",  gb: 3.5,  color: "#00d4aa"
      },
      { label: "LoRA",        gb: 0.5,  color: "#a78bfa"
      },
      { label: "Activations", gb: 4.0,  color: "#f59e0b"
      },
      { label: "Gradients",   gb: 2.0,  color: "#ef4444"
      },
      { label: "Libero",      gb: 10.0, color: "#1a2e3a"
      },
    ].map((s,i) => (
              <div key={i
    } title={`${s.label
      }: ${s.gb
      }GB`
    } style={
      {
                width:`${(s.gb/20)*100
        }%`, background:s.color,
                opacity: i===4 ? 0.3 : 1,
                display: "flex", alignItems: "center", justifyContent: "center",
      }
    }>
                {s.gb >= 2 && (
                  <span style={
        { fontSize: 8, fontWeight: 700, color: i===4?"#4a7a8f": "#080d14"
        }
      }>
                    {s.gb
      }G
                  </span>
                )
    }
              </div>
            ))
  }
          </div>
          <div style={
    { display: "flex", justifyContent: "space-between", marginTop: 4
    }
  }>
            <span style={
    { fontSize: 9, color: "#4a7a8f"
    }
  }>~10GB usati</span>
            <span style={
    { fontSize: 9, color: "#00d4aa", fontWeight: 700
    }
  }>~10GB liberi ✅</span>
          </div>
        </div>

        { /* Tags */}
        <div style={
    { display: "flex", gap: 6, marginTop: 10, flexWrap: "wrap"
    }
  }>
          {
    [
      "QLoRA 4-bit",
      "~10GB VRAM",
      "Unsloth",
      "SFTTrainer",
      "GGUF Q4_K_M",
      "LM Studio",
      "7 Step"
    ].map((t,i)=>(
            <span key={i
    } style={
      {
              fontSize: 10, padding: "3px 10px", borderRadius: 20,
              background: "#0f2030", color: "#00d4aa",
              fontWeight: 700, border: "1px solid #00d4aa44",
      }
    }>{t
    }</span>
          ))
  }
        </div>
      </div>

      <div style={
    { display: "flex", flex: 1, minHeight: 0
    }
  }>
        { /* Sidebar */}
        <div style={
    {
          width: 190, flexShrink: 0,
          background: "#0a0f18", borderRight: "1px solid #1a2e3a",
          overflowY: "auto",
    }
  }>
          {steps.map((s,i) => (
            <button key={i
    } onClick={()=>setActive(i)
    } style={
      {
              width: "100%", padding: "13px 14px",
              background: active===i ? "#0f1823": "transparent",
              borderLeft: active===i ? `3px solid ${s.color
        }` : "3px solid transparent",
              borderTop: "none", borderRight: "none",
              borderBottom: "1px solid #1a2e3a",
              textAlign: "left", cursor: "pointer", transition: "all 0.15s",
      }
    }>
              <div style={
      { fontSize: 9, letterSpacing: 2, color: active===i ? s.color : "#2a4a5a", fontWeight: 700, marginBottom: 3
      }
    }>
                {s.id
    }
              </div>
              <div style={
      { fontSize: 11.5, fontWeight: 700, color: active===i ? "#e8f4fc": "#4a7080", lineHeight: 1.3
      }
    }>
                {s.icon
    } {s.title
    }
              </div>
              <div style={
      { fontSize: 9, color: active===i ? s.color : "#2a4a5a", marginTop: 3, fontWeight: 600, letterSpacing: 1
      }
    }>
                {s.tag
    }
              </div>
            </button>
          ))
  }
          { /* Progress */}
          <div style={
    { padding: "14px", borderTop: "1px solid #1a2e3a"
    }
  }>
            <div style={
    { fontSize: 9, color: "#3a6a7a", marginBottom: 6, letterSpacing: 1
    }
  }>AVANZAMENTO</div>
            <div style={
    { height: 4, background: "#1a2e3a", borderRadius: 2, overflow: "hidden"
    }
  }>
              <div style={
    {
                height: "100%",
                width:`${((active+1)/steps.length)*100
      }%`,
                background: "#00d4aa", borderRadius: 2,
                transition: "width 0.3s ease",
    }
  }/>
            </div>
            <div style={
    { fontSize: 9, color: "#4a7a8f", marginTop: 4
    }
  }>
              {active+1
  } / {steps.length
  } step
            </div>
          </div>
        </div>

        { /* Contenuto principale */}
        <div style={
    { flex: 1, overflowY: "auto", padding: "24px 28px"
    }
  }>
          <div style={
    { borderLeft:`3px solid ${step.color
      }`, paddingLeft: 16, marginBottom: 18
    }
  }>
            <div style={
    { fontSize: 10, letterSpacing: 3, color:step.color, fontWeight: 700, textTransform: "uppercase", marginBottom: 4
    }
  }>
              Step {step.id
  } · {step.tag
  }
            </div>
            <div style={
    { fontSize: 19, fontWeight: 800, color: "#e8f4fc"
    }
  }>
              {step.icon
  } {step.title
  }
            </div>
            <div style={
    { fontSize: 13, color: "#6a9aaf", marginTop: 8, lineHeight: 1.7, maxWidth: 680
    }
  }>
              {step.desc
  }
            </div>
          </div>

          {step.warning && (
            <div style={
      {
              background: "#1a1500", border: "1px solid #f59e0b55",
              borderLeft: "3px solid #f59e0b",
              borderRadius: 8, padding: "12px 16px", marginBottom: 16,
              fontSize: 12, color: "#c8a84a", lineHeight: 1.7,
      }
    }>⚠️ {step.warning
    }</div>
          )
  }

          <div style={
    { background: "#040810", border: "1px solid #1a2e3a", borderRadius: 10, overflow: "hidden"
    }
  }>
            <div style={
    {
              background: "#0a0f18", padding: "10px 16px",
              borderBottom: "1px solid #1a2e3a",
              display: "flex", justifyContent: "space-between", alignItems: "center",
    }
  }>
              <span style={
    { fontSize: 10, letterSpacing: 2, color: "#3a6a7a", fontWeight: 700
    }
  }>CODE</span>
              <button onClick={copy
  } style={
    {
                fontSize: 11, padding: "4px 12px", borderRadius: 6,
                background: copied ? "#00d4aa22": "#0f1823",
                color: copied ? "#00d4aa": "#5a8090",
                border:`1px solid ${copied ? "#00d4aa44": "#1a2e3a"
      }`,
                cursor: "pointer", fontFamily: "inherit", fontWeight: 600,
                transition: "all 0.2s",
    }
  }>
                {copied ? "✓ Copiato": "Copia"
  }
              </button>
            </div>
            <div style={
    { overflowX: "auto"
    }
  }>
              <pre style={
    {
                margin: 0, padding: "18px 20px",
                fontSize: 11.5, lineHeight: 1.75, color: "#8ad4c0",
                fontFamily: "inherit", whiteSpace: "pre",
                minWidth: "max-content",
    }
  }>
                {step.code.split("\n").map((line,i) => (
                  <span key={i
    } style={
      {
                    display: "block",
                    color: line.trim().startsWith("#") || line.trim().startsWith("//")
                      ? "#2a5a6a": "#8ad4c0",
      }
    }>{line
    }</span>
                ))
  }
              </pre>
            </div>
          </div>

          { /* Navigazione */}
          <div style={
    { display: "flex", gap: 10, marginTop: 18, justifyContent: "flex-end", alignItems: "center"
    }
  }>
            {active > 0 && (
              <button onClick={()=>setActive(active-1)
    } style={
      {
                padding: "9px 18px", borderRadius: 8,
                background: "#0f1823", color: "#5a8090",
                border: "1px solid #1a2e3a", cursor: "pointer",
                fontSize: 12, fontFamily: "inherit", fontWeight: 600,
      }
    }>← Precedente</button>
            )
  }
            {active < steps.length-1 ? (
              <button onClick={()=>setActive(active+1)
    } style={
      {
                padding: "9px 18px", borderRadius: 8,
                background: steps[active+1
        ].color+"22",
                color: steps[active+1
        ].color,
                border:`1px solid ${steps[active+1
          ].color
        }44`,
                cursor: "pointer", fontSize: 12, fontFamily: "inherit", fontWeight: 600,
      }
    }>Successivo →</button>
            ) : (
              <div style={
      {
                padding: "9px 18px", borderRadius: 8,
                background: "#00d4aa22", color: "#00d4aa",
                border: "1px solid #00d4aa44",
                fontSize: 12, fontWeight: 700,
      }
    }>🎉 Pipeline completata!</div>
            )
  }
          </div>
        </div>
      </div>
    </div>
  );
}