// Legge la scena 3D e la serializza per DecAI
function getSceneContext() {
  const objs = [];
  scene.traverse(obj => {
    if (!obj.isMesh) return;
    const size = new THREE.Box3()
      .setFromObject(obj)
      .getSize(new THREE.Vector3());
    objs.push({
      nome:       obj.name || "senza_nome",
      categoria:  obj.userData.category || "non_definita",
      dim_mm: {
        x: Math.round(size.x * 1000),
        y: Math.round(size.y * 1000),
        z: Math.round(size.z * 1000),
          },
      selezionato: obj === selectedObject,
        });
      });
  return objs;
    }
    // Invia messaggio a DecAI con contesto scena iniettato
async function chatWithDecAI(userMsg, history = []) {
  const scene  = getSceneContext();
  const prefix = scene.length
    ? \`[SCENA 3D
      ]\\n\${JSON.stringify(scene,
        null,
        2)
      }\\n\\n\`
    : "";

  const messages = [
    ...history,
        { role: "user", content: prefix + userMsg
        },
      ];

  const res = await fetch(DECAI.url,
      {
    method: "POST",
    headers: {
          "Content-Type": "application/json"
        },
    body: JSON.stringify({
      model:       DECAI.model,
      messages,
      temperature: DECAI.temperature,
      max_tokens:  DECAI.maxTokens,
        }),
      });

  const data = await res.json();
  return data.choices[
        0
      ].message.content;
    }
