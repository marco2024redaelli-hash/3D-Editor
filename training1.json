from transformers import TrainingArguments
from datasets import load_dataset

# Carica e formatta dataset
dataset = load_dataset(
    "json",
    data_files = "deca_sales_dataset.jsonl",
    split      = "train"
)

def format_chat(example):
    return {
      "text": tokenizer.apply_chat_template(
        example[
        "messages"
      ],
        tokenize               = False,
        add_generation_prompt  = False,
        # Thinking DISABILITATO → risposte dirette per sales B2B
        # (Qwen3.5-4B ha thinking off di default, nessuna modifica necessaria)
    )
    }

dataset = dataset.map(format_chat, remove_columns=[
      "messages"
    ])
print(f"Dataset pronto: {len(dataset)} esempi")

# ── Training ottimizzato per Qwen3.5-4B su RTX 4000 Ada ──
training_args = TrainingArguments(
    output_dir = "./decai-4b-checkpoints",

    # 4B permette batch più grandi del 9B → training più veloce
    per_device_train_batch_size  = 4,   # 4 esempi/step (era 2 con 9B)
    gradient_accumulation_steps  = 4,   # batch effettivo = 16
    # VRAM picco stimato: ~10 GB → margine enorme ✅

    # Schedule
    num_train_epochs    = 3,
    learning_rate       = 2e-4,
    lr_scheduler_type   = "cosine",
    warmup_ratio        = 0.05,

    # Precisione Ada
    bf16  = True,
    fp16  = False,

    # Ottimizzatore 8-bit
    optim        = "adamw_8bit",
    weight_decay = 0.01,

    # Log & save
    logging_steps    = 5,
    save_strategy    = "epoch",
    save_total_limit = 2,
    seed             = 42,
)

trainer = SFTTrainer(
    model             = model,
    tokenizer         = tokenizer,
    train_dataset     = dataset,
    dataset_text_field = "text",
    max_seq_length    = 4096,
    args              = training_args,
)

# ── Avvia ──
print("Inizio QLoRA fine-tuning Qwen3.5-4B...")
stats = trainer.train()

print(f"\\n✅ Completato in {stats.metrics['train_runtime']/60:.1f} min")
print(f"Loss finale: {stats.metrics['train_loss']:.4f}")
# Target loss: < 0.8 buono | < 0.5 ottimo (attenzione overfitting)
